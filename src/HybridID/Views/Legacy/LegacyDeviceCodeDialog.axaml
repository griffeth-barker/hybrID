<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HybridID.Views.Legacy.LegacyDeviceCodeDialog"
        Title="Microsoft Graph Sign-In"
        Width="420" SizeToContent="Height"
        Background="{DynamicResource PanelBg}"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="avares://HybridID/Assets/hybrid-icon.png">
    <Grid Margin="25" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Text="Sign in to Microsoft Graph" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,12"/>
        <TextBlock Name="MessageText" Grid.Row="1" Foreground="{DynamicResource PrimaryText}" FontSize="13"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
