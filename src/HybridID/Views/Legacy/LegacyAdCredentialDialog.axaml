<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HybridID.Views.Legacy.LegacyAdCredentialDialog"
        Title="Active Directory Sign-In"
        Width="400" SizeToContent="Height"
        Background="{DynamicResource PanelBg}"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="avares://HybridID/Assets/hybrid-icon.png">
    <Grid Margin="25" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Text="Sign in to Active Directory" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Credentials are used for this session only and are not stored."
                   FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,15"/>

        <TextBox Name="TxtUsername" Grid.Row="2" PlaceholderText="user@domain.tld or DOMAIN\user" Margin="0,0,0,10"/>
        <TextBox Name="TxtPassword" Grid.Row="3" PlaceholderText="Password" PasswordChar="•" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="BtnCancel" Content="Cancel" Background="{DynamicResource MutedBrush}" Foreground="White" Margin="0,0,10,0" Classes="accent"/>
            <Button Name="BtnOk" Content="Sign In" Background="{DynamicResource AccentBrush}" Foreground="White" Classes="accent"/>
        </StackPanel>
    </Grid>
</Window>
