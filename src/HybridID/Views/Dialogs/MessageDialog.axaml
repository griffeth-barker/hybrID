<c:OverlayDialog xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="using:HybridID.Controls"
                 x:Class="HybridID.Views.Dialogs.MessageDialog"
                 Width="440"
                 DefaultButton="Primary">
  <!-- PLACEHOLDER (Phase 1/2). Phase 3 moves the severity icon next to the title (spec 5.4.3). -->
  <Grid ColumnDefinitions="Auto,*">
    <PathIcon x:Name="SeverityIcon" Width="20" Height="20" Margin="0,0,12,0"
              VerticalAlignment="Top" IsVisible="False"/>
    <SelectableTextBlock x:Name="MessageText" Grid.Column="1" Classes="body" TextWrapping="Wrap"/>
  </Grid>

  <c:OverlayDialog.Styles>
    <Style Selector="PathIcon#SeverityIcon.informational">
      <Setter Property="Data" Value="{DynamicResource Icon.InfoFilled}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}"/>
    </Style>
    <Style Selector="PathIcon#SeverityIcon.success">
      <Setter Property="Data" Value="{DynamicResource Icon.CheckCircleFilled}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
    </Style>
    <Style Selector="PathIcon#SeverityIcon.warning">
      <Setter Property="Data" Value="{DynamicResource Icon.WarningFilled}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
    </Style>
    <Style Selector="PathIcon#SeverityIcon.error">
      <Setter Property="Data" Value="{DynamicResource Icon.ErrorFilled}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
    </Style>
  </c:OverlayDialog.Styles>
</c:OverlayDialog>
