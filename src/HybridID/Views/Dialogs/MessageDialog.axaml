<c:OverlayDialog xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="using:HybridID.Controls"
                 x:Class="HybridID.Views.Dialogs.MessageDialog"
                 Width="440"
                 DefaultButton="Primary">
  <!-- docs/design/ui-spec.md section 5.4.3. The optional severity icon sits left of the title
       (OverlayDialog.TitleIcon), set from code. -->
  <SelectableTextBlock x:Name="MessageText" Classes="body" TextWrapping="Wrap"/>

  <c:OverlayDialog.Styles>
    <Style Selector="PathIcon.severity.informational">
      <Setter Property="Data" Value="{DynamicResource Icon.InfoFilled}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}"/>
    </Style>
    <Style Selector="PathIcon.severity.success">
      <Setter Property="Data" Value="{DynamicResource Icon.CheckCircleFilled}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
    </Style>
    <Style Selector="PathIcon.severity.warning">
      <Setter Property="Data" Value="{DynamicResource Icon.WarningFilled}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
    </Style>
    <Style Selector="PathIcon.severity.error">
      <Setter Property="Data" Value="{DynamicResource Icon.ErrorFilled}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
    </Style>
  </c:OverlayDialog.Styles>
</c:OverlayDialog>
