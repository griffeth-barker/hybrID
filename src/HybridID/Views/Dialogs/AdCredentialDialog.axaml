<c:OverlayDialog xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="using:HybridID.Controls"
                 x:Class="HybridID.Views.Dialogs.AdCredentialDialog"
                 Width="440"
                 Title="Sign in to Active Directory"
                 PrimaryButtonText="Sign in"
                 CloseButtonText="Skip"
                 DefaultButton="Primary">
  <!-- PLACEHOLDER (Phase 1/2): minimal but working. Phase 3 adds the reveal toggle, the Critical
       InfoBar for errors, the lock note styling etc. per spec section 5.4.1. -->
  <StackPanel>
    <TextBlock x:Name="ServerText" Classes="caption secondary" Margin="0,0,0,16" TextWrapping="Wrap"/>
    <TextBlock Classes="body" Text="Username" Margin="0,0,0,8"/>
    <TextBox x:Name="UsernameBox" PlaceholderText="user@contoso.com or CONTOSO\user"
             AutomationProperties.Name="Username"/>
    <TextBlock Classes="body" Text="Password" Margin="0,16,0,8"/>
    <TextBox x:Name="PasswordBox" PasswordChar="•" AutomationProperties.Name="Password"/>
    <TextBlock Classes="caption secondary" Margin="0,8,0,0" TextWrapping="Wrap"
               Text="Used for this session only. Never saved to disk."/>
    <TextBlock x:Name="ErrorText" Classes="caption critical" Margin="0,16,0,0" TextWrapping="Wrap" IsVisible="False"/>
  </StackPanel>
</c:OverlayDialog>
