<c:OverlayDialog xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="using:HybridID.Controls"
                 x:Class="HybridID.Views.Dialogs.AdCredentialDialog"
                 Width="440"
                 Title="Sign in to Active Directory"
                 PrimaryButtonText="Sign in"
                 CloseButtonText="Skip"
                 DefaultButton="Primary">
  <!-- docs/design/ui-spec.md section 5.4.1. -->
  <c:OverlayDialog.Styles>
    <Style Selector="PathIcon.secondary">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>
  </c:OverlayDialog.Styles>

  <StackPanel>
    <Grid ColumnDefinitions="Auto,6,*" Margin="0,0,0,16">
      <PathIcon Data="{StaticResource Icon.Building}" Width="12" Height="12" Classes="secondary"
                VerticalAlignment="Center"/>
      <TextBlock x:Name="ServerText" Grid.Column="2" Classes="caption secondary" TextWrapping="Wrap"/>
    </Grid>

    <TextBlock Classes="body" Text="Username" Margin="0,0,0,8"/>
    <TextBox x:Name="UsernameBox" PlaceholderText="user@contoso.com or CONTOSO\user"
             AutomationProperties.Name="Username"/>

    <TextBlock Classes="body" Text="Password" Margin="0,16,0,8"/>
    <TextBox x:Name="PasswordBox" PasswordChar="•" AutomationProperties.Name="Password">
      <TextBox.InnerRightContent>
        <Button x:Name="BtnReveal" Classes="subtle icon" Width="28" Height="28" Margin="0,0,2,0"
                ToolTip.Tip="Show password" AutomationProperties.Name="Show password">
          <PathIcon x:Name="RevealIcon" Data="{StaticResource Icon.Eye}" Width="16" Height="16"/>
        </Button>
      </TextBox.InnerRightContent>
    </TextBox>

    <Grid ColumnDefinitions="Auto,6,*" Margin="0,8,0,0">
      <PathIcon Data="{StaticResource Icon.Lock}" Width="12" Height="12" Classes="secondary"
                VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Classes="caption secondary" TextWrapping="Wrap"
                 Text="Used for this session only. Never saved to disk."/>
    </Grid>

    <c:InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" IsOpen="False"
               Title="Couldn't connect" Margin="0,16,0,0"/>
  </StackPanel>
</c:OverlayDialog>
