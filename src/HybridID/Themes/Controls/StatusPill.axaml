<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:HybridID.Controls">
  <!-- StatusPill (docs/design/ui-spec.md section 6.4). Tinted, icon + text. Stroke tokens are
       Transparent in Light and a 20% foreground outline in Dark. -->
  <ControlTheme x:Key="{x:Type c:StatusPill}" TargetType="c:StatusPill">
    <Setter Property="Height" Value="24"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorNeutralBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorNeutralStrokeBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <PathIcon Width="12" Height="12"
                      VerticalAlignment="Center"
                      Data="{TemplateBinding Icon}"
                      Foreground="{TemplateBinding Foreground}"
                      IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock x:Name="PART_Text"
                       Classes="caption"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{TemplateBinding Text}"
                       Foreground="{TemplateBinding Foreground}"/>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:icon">
      <Setter Property="Padding" Value="6,0,8,0"/>
    </Style>
    <Style Selector="^.small">
      <Setter Property="Height" Value="20"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="6,0"/>
    </Style>

    <Style Selector="^:onprem">
      <Setter Property="Background" Value="{DynamicResource LocationOnPremBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource LocationOnPremForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LocationOnPremStrokeBrush}"/>
    </Style>
    <Style Selector="^:hybrid">
      <Setter Property="Background" Value="{DynamicResource LocationHybridBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource LocationHybridForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LocationHybridStrokeBrush}"/>
    </Style>
    <Style Selector="^:cloud">
      <Setter Property="Background" Value="{DynamicResource LocationCloudBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource LocationCloudForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LocationCloudStrokeBrush}"/>
    </Style>
    <Style Selector="^:success">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessStrokeBrush}"/>
    </Style>
    <Style Selector="^:caution">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionStrokeBrush}"/>
    </Style>
    <Style Selector="^:critical">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalStrokeBrush}"/>
    </Style>
    <Style Selector="^:neutral">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorNeutralBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorNeutralStrokeBrush}"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>
