<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:HybridID.Controls">
  <!-- ManagementCard (docs/design/ui-spec.md section 6.6) -->
  <ControlTheme x:Key="{x:Type c:ManagementCard}" TargetType="c:ManagementCard">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
    <Setter Property="Padding" Value="{DynamicResource ManagementCardPadding}"/>
    <Setter Property="MinHeight" Value="176"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                MinHeight="{TemplateBinding MinHeight}">
          <DockPanel>
            <!-- Action row, pushed to the bottom so paired cards align. -->
            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0" ColumnDefinitions="Auto,*">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PART_PrimaryButton"
                        Classes="accent"
                        Height="36" MinWidth="160"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="False">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{TemplateBinding PrimaryText}" VerticalAlignment="Center"/>
                    <PathIcon Data="{DynamicResource Icon.Open12}" Width="12" Height="12" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="PART_CopyLinkButton"
                        Classes="subtle icon"
                        Width="36" Height="36"
                        IsVisible="False">
                  <PathIcon Data="{DynamicResource Icon.Link}" Width="16" Height="16"/>
                </Button>
                <ContentPresenter Content="{TemplateBinding SecondaryContent}"
                                  VerticalAlignment="Center"
                                  IsVisible="{TemplateBinding SecondaryContent, Converter={x:Static ObjectConverters.IsNotNull}}"/>
              </StackPanel>
              <!-- Takes the remaining width and trims rather than overflowing narrow cards. -->
              <HyperlinkButton x:Name="PART_ViewLinkButton" Grid.Column="1"
                               Margin="8,0,0,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               IsVisible="False">
                <Grid ColumnDefinitions="*,4,Auto">
                  <TextBlock Text="{TemplateBinding ViewLinkText}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                  <PathIcon Grid.Column="2" Data="{DynamicResource Icon.Open12}" Width="12" Height="12"
                            VerticalAlignment="Center"/>
                </Grid>
              </HyperlinkButton>
            </Grid>

            <StackPanel>
              <Grid ColumnDefinitions="40,12,*">
                <Border x:Name="PART_Badge"
                        Width="40" Height="40"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        VerticalAlignment="Top">
                  <PathIcon x:Name="PART_BadgeIcon" Width="20" Height="20" Data="{TemplateBinding Icon}"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Classes="caption secondary" Text="{TemplateBinding Overline}"/>
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Classes="subtitle"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{TemplateBinding LocationTitle}"
                               AutomationProperties.HeadingLevel="2"/>
                    <c:StatusPill x:Name="PART_Tag"
                                  Kind="Neutral"
                                  VerticalAlignment="Center"
                                  Text="{TemplateBinding TagText}"
                                  IsVisible="False"/>
                  </WrapPanel>
                </StackPanel>
              </Grid>
              <TextBlock Classes="body secondary"
                         Margin="0,12,0,0"
                         TextWrapping="Wrap"
                         MaxLines="3"
                         TextTrimming="CharacterEllipsis"
                         Text="{TemplateBinding Body}"
                         IsVisible="{TemplateBinding Body, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Grid x:Name="PART_Warning" ColumnDefinitions="Auto,6,*" Margin="0,8,0,0" IsVisible="False">
                <PathIcon Data="{DynamicResource Icon.Warning}" Width="12" Height="12"
                          Margin="0,3,0,0" VerticalAlignment="Top"
                          Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                <StackPanel Grid.Column="2">
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="{TemplateBinding WarningText}"/>
                  <ContentPresenter Content="{TemplateBinding WarningActionContent}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:primary">
      <Style Selector="^ /template/ Button#PART_PrimaryButton">
        <Setter Property="IsVisible" Value="True"/>
      </Style>
      <Style Selector="^ /template/ Button#PART_CopyLinkButton">
        <Setter Property="IsVisible" Value="True"/>
      </Style>
    </Style>
    <Style Selector="^:viewlink /template/ HyperlinkButton#PART_ViewLinkButton">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:warning /template/ Grid#PART_Warning">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:tag /template/ c|StatusPill#PART_Tag">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="^:onprem">
      <Style Selector="^ /template/ Border#PART_Badge">
        <Setter Property="Background" Value="{DynamicResource LocationOnPremBackgroundBrush}"/>
      </Style>
      <Style Selector="^ /template/ PathIcon#PART_BadgeIcon">
        <Setter Property="Foreground" Value="{DynamicResource LocationOnPremForegroundBrush}"/>
      </Style>
    </Style>
    <Style Selector="^:cloud">
      <Style Selector="^ /template/ Border#PART_Badge">
        <Setter Property="Background" Value="{DynamicResource LocationCloudBackgroundBrush}"/>
      </Style>
      <Style Selector="^ /template/ PathIcon#PART_BadgeIcon">
        <Setter Property="Foreground" Value="{DynamicResource LocationCloudForegroundBrush}"/>
      </Style>
    </Style>
    <Style Selector="^:neutral">
      <Style Selector="^ /template/ Border#PART_Badge">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}"/>
      </Style>
      <Style Selector="^ /template/ PathIcon#PART_BadgeIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
