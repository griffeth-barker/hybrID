<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:HybridID.Controls">
  <!-- ProgressRing (docs/design/ui-spec.md section 6.8): Arc with rotating panel + breathing sweep.
       Animations only under :active (see ProgressRing.cs). -->
  <ControlTheme x:Key="{x:Type c:ProgressRing}" TargetType="c:ProgressRing">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="PART_Rotor" RenderTransformOrigin="50%,50%">
          <Panel.RenderTransform>
            <RotateTransform/>
          </Panel.RenderTransform>
          <Arc x:Name="PART_Arc"
               Stroke="{TemplateBinding Foreground}"
               StrokeThickness="2"
               StrokeLineCap="Round"
               StartAngle="-90"
               SweepAngle="90"/>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:large /template/ Arc#PART_Arc">
      <Setter Property="StrokeThickness" Value="3"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
    </Style>

    <Style Selector="^:active /template/ Panel#PART_Rotor">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:active /template/ Arc#PART_Arc">
      <Style.Animations>
        <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="SweepAngle" Value="30"/>
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="SweepAngle" Value="270"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="SweepAngle" Value="30"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
