      <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#61CAFF"/>
      <Color x:Key="SystemFillColorNeutral">#8BFFFFFF</Color>
      <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#8BFFFFFF"/>
      <Color x:Key="SystemFillColorSuccessBackground">#393D1B</Color>
      <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#393D1B"/>
      <Color x:Key="SystemFillColorCautionBackground">#433519</Color>
      <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#433519"/>
      <Color x:Key="SystemFillColorCriticalBackground">#442726</Color>
      <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#442726"/>
      <Color x:Key="SystemFillColorAttentionBackground">#08FFFFFF</Color>
      <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#08FFFFFF"/>
      <Color x:Key="SystemFillColorNeutralBackground">#08FFFFFF</Color>
      <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#08FFFFFF"/>
      <Color x:Key="SystemFillColorSuccessStroke">#336CCB5F</Color>
      <SolidColorBrush x:Key="SystemFillColorSuccessStrokeBrush" Color="#336CCB5F"/>
      <Color x:Key="SystemFillColorCautionStroke">#33FCE100</Color>
      <SolidColorBrush x:Key="SystemFillColorCautionStrokeBrush" Color="#33FCE100"/>
      <Color x:Key="SystemFillColorCriticalStroke">#33FF99A4</Color>
      <SolidColorBrush x:Key="SystemFillColorCriticalStrokeBrush" Color="#33FF99A4"/>
      <Color x:Key="SystemFillColorNeutralStroke">#1FFFFFFF</Color>
      <SolidColorBrush x:Key="SystemFillColorNeutralStrokeBrush" Color="#1FFFFFFF"/>

      <!-- 3.1.6 Management-location colors (tinted badges; Stroke keys = 1px pill outline, Dark only) -->
      <Color x:Key="LocationOnPremForeground">#5FD4DA</Color>
      <SolidColorBrush x:Key="LocationOnPremForegroundBrush" Color="#5FD4DA"/>
      <Color x:Key="LocationOnPremBackground">#0F3A3D</Color>
      <SolidColorBrush x:Key="LocationOnPremBackgroundBrush" Color="#0F3A3D"/>
      <Color x:Key="LocationOnPremStroke">#335FD4DA</Color>
      <SolidColorBrush x:Key="LocationOnPremStrokeBrush" Color="#335FD4DA"/>
      <Color x:Key="LocationHybridForeground">#C7A6F5</Color>
      <SolidColorBrush x:Key="LocationHybridForegroundBrush" Color="#C7A6F5"/>
      <Color x:Key="LocationHybridBackground">#34224F</Color>
      <SolidColorBrush x:Key="LocationHybridBackgroundBrush" Color="#34224F"/>
      <Color x:Key="LocationHybridStroke">#33C7A6F5</Color>
      <SolidColorBrush x:Key="LocationHybridStrokeBrush" Color="#33C7A6F5"/>
      <Color x:Key="LocationCloudForeground">#A9B8FF</Color>
      <SolidColorBrush x:Key="LocationCloudForegroundBrush" Color="#A9B8FF"/>
      <Color x:Key="LocationCloudBackground">#1F2A5C</Color>
      <SolidColorBrush x:Key="LocationCloudBackgroundBrush" Color="#1F2A5C"/>
      <Color x:Key="LocationCloudStroke">#33A9B8FF</Color>
      <SolidColorBrush x:Key="LocationCloudStrokeBrush" Color="#33A9B8FF"/>

      <!-- 3.5 Elevation: floating surfaces only (cards have no shadow) -->
      <BoxShadows x:Key="ShadowFlyout">0 0 2 0 #3D000000, 0 8 16 0 #47000000</BoxShadows>
      <BoxShadows x:Key="ShadowDialog">0 0 8 0 #3D000000, 0 32 64 0 #47000000</BoxShadows>

      <!-- Fluent theme keys mapped onto the tokens above -->
      <!-- Accent button / hyperlink (3.1.1) -->
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#007ACC"/>
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0070BB"/>
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0063A6"/>
      <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#28FFFFFF"/>
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF"/>
      <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#87FFFFFF"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#00000000"/>
      <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#99E7FF"/>
      <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#61CAFF"/>
      <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#99E7FF"/>
      <SolidColorBrush x:Key="HyperlinkButtonForegroundVisited" Color="#99E7FF"/>
      <SolidColorBrush x:Key="HyperlinkButtonForegroundVisitedPointerOver" Color="#61CAFF"/>
      <SolidColorBrush x:Key="HyperlinkButtonForegroundVisitedPressed" Color="#99E7FF"/>
      <SolidColorBrush x:Key="HyperlinkButtonForegroundDisabled" Color="#5DFFFFFF"/>
      <!-- Standard button: WinUI control fill + stroke (3.1.3) -->
      <SolidColorBrush x:Key="ButtonBackground" Color="#0FFFFFFF"/>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#15FFFFFF"/>
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#08FFFFFF"/>
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0BFFFFFF"/>
      <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C5FFFFFF"/>
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5DFFFFFF"/>
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#12FFFFFF"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#12FFFFFF"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#12FFFFFF"/>
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#12FFFFFF"/>
      <!-- Text input (TextBox, NumericUpDown) -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#0FFFFFFF"/>
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#15FFFFFF"/>
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#B31E1E1E"/>
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#0BFFFFFF"/>
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#18FFFFFF"/>
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#18FFFFFF"/>
      <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#C5FFFFFF"/>
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#C5FFFFFF"/>
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#87FFFFFF"/>
      <!-- ComboBox -->
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#0FFFFFFF"/>
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#15FFFFFF"/>
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#08FFFFFF"/>
      <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#0BFFFFFF"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#18FFFFFF"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#18FFFFFF"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#18FFFFFF"/>
      <!-- Popups get no backdrop: solid surfaces (4.3) -->
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2C2C2C"/>
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#66757575"/>
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#2C2C2C"/>
      <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#66757575"/>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2C2C2C"/>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#66757575"/>
      <SolidColorBrush x:Key="ToolTipBackground" Color="#2C2C2C"/>
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#66757575"/>
      <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF"/>
      <!-- Focus visuals (3.1.4) -->
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#B3000000"/>

      <!-- LEGACY: delete with Views/Legacy (Phase 7) -->
      <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E"/>
      <SolidColorBrush x:Key="PanelBg" Color="#252526"/>
      <SolidColorBrush x:Key="InputBg" Color="#2D2D30"/>
      <SolidColorBrush x:Key="AppBorderBrush" Color="#3F3F46"/>
      <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SecondaryText" Color="#CCCCCC"/>
      <SolidColorBrush x:Key="NotesText" Color="#DCDCAA"/>
      <SolidColorBrush x:Key="LinkText" Color="#569CD6"/>
      <SolidColorBrush x:Key="StatusBarBg" Color="#007ACC"/>
      <!-- END LEGACY -->
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- 3.2 Typography: font families (theme-invariant). Windows 11 gets Segoe UI Variable,
       Windows 10 Segoe UI, macOS/Linux the bundled Inter (Program.cs .WithInterFont()). -->
  <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI, fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="FontFamilyText">Segoe UI Variable Text, Segoe UI, fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="FontFamilyDisplay">Segoe UI Variable Display, Segoe UI, fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="FontFamilySmall">Segoe UI Variable Small, Segoe UI, fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="FontFamilyMono">avares://HybridID/Assets/Fonts#Cascadia Mono</FontFamily>
  <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
  <x:Double x:Key="ToolTipContentThemeFontSize">12</x:Double>

  <!-- 3.3 Spacing (4 px grid) -->
  <Thickness x:Key="PagePadding">32,24,32,32</Thickness>
  <Thickness x:Key="CardPadding">16</Thickness>
  <Thickness x:Key="ManagementCardPadding">20</Thickness>
  <Thickness x:Key="DialogPadding">24</Thickness>
  <Thickness x:Key="ButtonPadding">11,5,11,6</Thickness>

  <!-- 3.4 Corner radii -->
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="PillCornerRadius">12</CornerRadius>

  <!-- 3.6 Focus ring: 2 px outer + 1 px inner -->
  <Thickness x:Key="SystemControlFocusVisualPrimaryThickness">2</Thickness>
  <Thickness x:Key="SystemControlFocusVisualSecondaryThickness">1</Thickness>

  <!-- LEGACY: delete with Views/Legacy (Phase 7). Theme-invariant legacy keys. -->
  <SolidColorBrush x:Key="StatusInfoBrush" Color="#CA5100"/>
  <SolidColorBrush x:Key="StatusSuccessBrush" Color="#16825D"/>
  <SolidColorBrush x:Key="StatusErrorBrush" Color="#D03E3D"/>
  <SolidColorBrush x:Key="StatusReadyBrush" Color="#007ACC"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#888888"/>
  <SolidColorBrush x:Key="SyncOnPremBrush" Color="#6E6E6E"/>
  <SolidColorBrush x:Key="SyncHybridBrush" Color="#8250DF"/>
  <SolidColorBrush x:Key="SyncCloudOnlyBrush" Color="#0078D4"/>
  <SolidColorBrush x:Key="AccountEnabledBrush" Color="#16825D"/>
  <SolidColorBrush x:Key="AccountDisabledBrush" Color="#6E6E6E"/>
  <SolidColorBrush x:Key="AccountLockedBrush" Color="#D03E3D"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#B58900"/>
  <!-- END LEGACY -->
</ResourceDictionary>
