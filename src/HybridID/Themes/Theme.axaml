<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    hybrID design tokens (docs/design/ui-spec.md section 3). Generated layout: every color key
    exists in both the Light and Dark theme dictionaries, as a Color (X) and a
    SolidColorBrush (XBrush). Views reference brushes with {DynamicResource XBrush} only, never
    hex values, so live theme switching works. The WinUI token names do not exist in Avalonia's
    Fluent theme; they are defined here and the Fluent keys we override are mapped onto them.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">

      <!-- 3.1.1 Accent (brand #007ACC) - theme-invariant values, declared per variant because Fluent reads them per variant -->
      <Color x:Key="SystemAccentColor">#007ACC</Color>
      <Color x:Key="SystemAccentColorLight1">#0096FA</Color>
      <Color x:Key="SystemAccentColorLight2">#61CAFF</Color>
      <Color x:Key="SystemAccentColorLight3">#99E7FF</Color>
      <Color x:Key="SystemAccentColorDark1">#0061B0</Color>
      <Color x:Key="SystemAccentColorDark2">#00428C</Color>
      <Color x:Key="SystemAccentColorDark3">#001E63</Color>
      <Color x:Key="AccentFillColorDefault">#007ACC</Color>
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#007ACC"/>
      <Color x:Key="AccentFillColorSecondary">#0070BB</Color>
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0070BB"/>
      <Color x:Key="AccentFillColorTertiary">#0063A6</Color>
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0063A6"/>
      <Color x:Key="TextOnAccentFillColorPrimary">#FFFFFF</Color>
      <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
      <Color x:Key="TextOnAccentFillColorSecondary">#E6FFFFFF</Color>
      <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF"/>
      <Color x:Key="AccentFillColorDisabled">#37000000</Color>
      <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#37000000"/>
      <Color x:Key="TextOnAccentFillColorDisabled">#FFFFFF</Color>
      <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FFFFFF"/>
      <Color x:Key="AccentTextFillColorPrimary">#00428C</Color>
      <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#00428C"/>
      <Color x:Key="AccentTextFillColorSecondary">#001E63</Color>
      <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#001E63"/>
      <Color x:Key="AccentTextFillColorTertiary">#0061B0</Color>
      <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#0061B0"/>

      <!-- 3.1.2 Text -->
      <Color x:Key="TextFillColorPrimary">#E4000000</Color>
      <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000"/>
      <Color x:Key="TextFillColorSecondary">#9E000000</Color>
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000"/>
      <Color x:Key="TextFillColorTertiary">#72000000</Color>
      <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000"/>
      <Color x:Key="TextFillColorDisabled">#5C000000</Color>
      <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C000000"/>

      <!-- 3.1.3 Backgrounds / layers -->
      <Color x:Key="SolidBackgroundFillColorBase">#F3F3F3</Color>
      <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F3F3F3"/>
      <Color x:Key="SolidBackgroundFillColorSecondary">#EEEEEE</Color>
      <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#EEEEEE"/>
      <Color x:Key="SolidBackgroundFillColorTertiary">#F9F9F9</Color>
      <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#F9F9F9"/>
      <Color x:Key="SolidBackgroundFillColorQuarternary">#FFFFFF</Color>
      <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FFFFFF"/>
      <Color x:Key="LayerFillColorDefault">#80FFFFFF</Color>
      <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#80FFFFFF"/>
      <Color x:Key="LayerFillColorAlt">#FFFFFF</Color>
      <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FFFFFF"/>
      <Color x:Key="CardBackgroundFillColorDefault">#B3FFFFFF</Color>
      <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF"/>
      <Color x:Key="CardBackgroundFillColorSecondary">#80F6F6F6</Color>
      <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#80F6F6F6"/>
      <Color x:Key="ControlFillColorDefault">#B3FFFFFF</Color>
      <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF"/>
      <Color x:Key="ControlFillColorSecondary">#80F9F9F9</Color>
      <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#80F9F9F9"/>
      <Color x:Key="ControlFillColorTertiary">#4DF9F9F9</Color>
      <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4DF9F9F9"/>
      <Color x:Key="ControlFillColorDisabled">#4DF9F9F9</Color>
      <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#4DF9F9F9"/>
      <Color x:Key="ControlFillColorInputActive">#FFFFFF</Color>
      <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFF"/>
      <Color x:Key="SubtleFillColorTransparent">#00FFFFFF</Color>
      <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF"/>
      <Color x:Key="SubtleFillColorSecondary">#09000000</Color>
      <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#09000000"/>
      <Color x:Key="SubtleFillColorTertiary">#06000000</Color>
      <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06000000"/>
      <Color x:Key="SmokeFillColorDefault">#4D000000</Color>
      <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000"/>

      <!-- 3.1.4 Strokes -->
      <Color x:Key="CardStrokeColorDefault">#0F000000</Color>
      <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000"/>
      <Color x:Key="CardStrokeColorDefaultSolid">#EBEBEB</Color>
      <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#EBEBEB"/>
      <Color x:Key="ControlStrokeColorDefault">#0F000000</Color>
      <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#0F000000"/>
      <Color x:Key="ControlStrokeColorSecondary">#29000000</Color>
      <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#29000000"/>
      <Color x:Key="ControlStrongStrokeColorDefault">#72000000</Color>
      <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#72000000"/>
      <Color x:Key="DividerStrokeColorDefault">#14000000</Color>
      <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#14000000"/>
      <Color x:Key="SurfaceStrokeColorDefault">#66757575</Color>
      <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#66757575"/>
      <Color x:Key="FocusStrokeColorOuter">#E4000000</Color>
      <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#E4000000"/>
      <Color x:Key="FocusStrokeColorInner">#B3FFFFFF</Color>
      <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#B3FFFFFF"/>

      <!-- 3.1.5 Semantic (system) colors - icons, dots and pill text only -->
      <Color x:Key="SystemFillColorSuccess">#0F7B0F</Color>
      <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#0F7B0F"/>
      <Color x:Key="SystemFillColorCaution">#9D5D00</Color>
      <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#9D5D00"/>
      <Color x:Key="SystemFillColorCritical">#C42B1C</Color>
      <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C"/>
      <Color x:Key="SystemFillColorAttention">#0061B0</Color>
      <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#0061B0"/>
      <Color x:Key="SystemFillColorNeutral">#72000000</Color>
      <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#72000000"/>
      <Color x:Key="SystemFillColorSuccessBackground">#DFF6DD</Color>
      <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#DFF6DD"/>
      <Color x:Key="SystemFillColorCautionBackground">#FFF4CE</Color>
      <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FFF4CE"/>
      <Color x:Key="SystemFillColorCriticalBackground">#FDE7E9</Color>
      <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FDE7E9"/>
      <Color x:Key="SystemFillColorAttentionBackground">#80F6F6F6</Color>
      <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#80F6F6F6"/>
      <Color x:Key="SystemFillColorNeutralBackground">#06000000</Color>
      <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#06000000"/>
      <Color x:Key="SystemFillColorSuccessStroke">#00000000</Color>
      <SolidColorBrush x:Key="SystemFillColorSuccessStrokeBrush" Color="#00000000"/>
      <Color x:Key="SystemFillColorCautionStroke">#00000000</Color>
      <SolidColorBrush x:Key="SystemFillColorCautionStrokeBrush" Color="#00000000"/>
      <Color x:Key="SystemFillColorCriticalStroke">#00000000</Color>
      <SolidColorBrush x:Key="SystemFillColorCriticalStrokeBrush" Color="#00000000"/>
      <Color x:Key="SystemFillColorNeutralStroke">#00000000</Color>
      <SolidColorBrush x:Key="SystemFillColorNeutralStrokeBrush" Color="#00000000"/>

      <!-- 3.1.6 Management-location colors (tinted badges; Stroke keys = 1px pill outline, Dark only) -->
      <Color x:Key="LocationOnPremForeground">#00666D</Color>
      <SolidColorBrush x:Key="LocationOnPremForegroundBrush" Color="#00666D"/>
      <Color x:Key="LocationOnPremBackground">#E6F4F5</Color>
      <SolidColorBrush x:Key="LocationOnPremBackgroundBrush" Color="#E6F4F5"/>
      <Color x:Key="LocationOnPremStroke">#00000000</Color>
      <SolidColorBrush x:Key="LocationOnPremStrokeBrush" Color="#00000000"/>
      <Color x:Key="LocationHybridForeground">#6B3FA0</Color>
      <SolidColorBrush x:Key="LocationHybridForegroundBrush" Color="#6B3FA0"/>
      <Color x:Key="LocationHybridBackground">#F2EDFA</Color>
      <SolidColorBrush x:Key="LocationHybridBackgroundBrush" Color="#F2EDFA"/>
      <Color x:Key="LocationHybridStroke">#00000000</Color>
      <SolidColorBrush x:Key="LocationHybridStrokeBrush" Color="#00000000"/>
      <Color x:Key="LocationCloudForeground">#3B4FC4</Color>
      <SolidColorBrush x:Key="LocationCloudForegroundBrush" Color="#3B4FC4"/>
      <Color x:Key="LocationCloudBackground">#EBEFFC</Color>
      <SolidColorBrush x:Key="LocationCloudBackgroundBrush" Color="#EBEFFC"/>
      <Color x:Key="LocationCloudStroke">#00000000</Color>
      <SolidColorBrush x:Key="LocationCloudStrokeBrush" Color="#00000000"/>

      <!-- 3.5 Elevation: floating surfaces only (cards have no shadow) -->
      <BoxShadows x:Key="ShadowFlyout">0 0 2 0 #1F000000, 0 8 16 0 #24000000</BoxShadows>
      <BoxShadows x:Key="ShadowDialog">0 0 8 0 #1F000000, 0 32 64 0 #24000000</BoxShadows>

      <!-- Fluent theme keys mapped onto the tokens above -->
      <!-- Accent button / hyperlink (3.1.1) -->
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#007ACC"/>
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0070BB"/>
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0063A6"/>
      <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#37000000"/>
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF"/>
      <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000"/>
      <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#00000000"/>
      <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#00428C"/>
      <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#0061B0"/>
      <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#001E63"/>
      <SolidColorBrush x:Key="HyperlinkButtonForegroundVisited" Color="#00428C"/>
      <SolidColorBrush x:Key="HyperlinkButtonForegroundVisitedPointerOver" Color="#0061B0"/>
      <SolidColorBrush x:Key="HyperlinkButtonForegroundVisitedPressed" Color="#001E63"/>
      <SolidColorBrush x:Key="HyperlinkButtonForegroundDisabled" Color="#5C000000"/>
      <!-- Standard button: WinUI control fill + stroke (3.1.3) -->
      <SolidColorBrush x:Key="ButtonBackground" Color="#B3FFFFFF"/>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#80F9F9F9"/>
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4DF9F9F9"/>
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#4DF9F9F9"/>
      <SolidColorBrush x:Key="ButtonForeground" Color="#E4000000"/>
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E4000000"/>
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#9E000000"/>
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5C000000"/>
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#0F000000"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#0F000000"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#0F000000"/>
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#0F000000"/>
      <!-- Text input (TextBox, NumericUpDown) -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#B3FFFFFF"/>
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#80F9F9F9"/>
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#4DF9F9F9"/>
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#29000000"/>
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#29000000"/>
      <SolidColorBrush x:Key="TextControlForeground" Color="#E4000000"/>
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E4000000"/>
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E4000000"/>
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#9E000000"/>
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#9E000000"/>
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#72000000"/>
      <!-- ComboBox -->
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#B3FFFFFF"/>
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#80F9F9F9"/>
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#4DF9F9F9"/>
      <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#4DF9F9F9"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#29000000"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#29000000"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#29000000"/>
      <!-- Popups get no backdrop: solid surfaces (4.3) -->
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#66757575"/>
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#66757575"/>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#66757575"/>
      <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#66757575"/>
      <SolidColorBrush x:Key="ToolTipForeground" Color="#E4000000"/>
      <!-- Focus visuals (3.1.4) -->
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#E4000000"/>
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#B3FFFFFF"/>

      <!-- LEGACY: delete with Views/Legacy (Phase 7) -->
      <SolidColorBrush x:Key="WindowBg" Color="#F3F3F3"/>
      <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AppBorderBrush" Color="#CCCCCC"/>
      <SolidColorBrush x:Key="PrimaryText" Color="#000000"/>
      <SolidColorBrush x:Key="SecondaryText" Color="#555555"/>
      <SolidColorBrush x:Key="NotesText" Color="#006600"/>
      <SolidColorBrush x:Key="LinkText" Color="#0066CC"/>
      <SolidColorBrush x:Key="StatusBarBg" Color="#007ACC"/>
      <!-- END LEGACY -->
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">

      <!-- 3.1.1 Accent (brand #007ACC) - theme-invariant values, declared per variant because Fluent reads them per variant -->
      <Color x:Key="SystemAccentColor">#007ACC</Color>
      <Color x:Key="SystemAccentColorLight1">#0096FA</Color>
      <Color x:Key="SystemAccentColorLight2">#61CAFF</Color>
      <Color x:Key="SystemAccentColorLight3">#99E7FF</Color>
      <Color x:Key="SystemAccentColorDark1">#0061B0</Color>
      <Color x:Key="SystemAccentColorDark2">#00428C</Color>
      <Color x:Key="SystemAccentColorDark3">#001E63</Color>
      <Color x:Key="AccentFillColorDefault">#007ACC</Color>
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#007ACC"/>
      <Color x:Key="AccentFillColorSecondary">#0070BB</Color>
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0070BB"/>
      <Color x:Key="AccentFillColorTertiary">#0063A6</Color>
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0063A6"/>
      <Color x:Key="TextOnAccentFillColorPrimary">#FFFFFF</Color>
      <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
      <Color x:Key="TextOnAccentFillColorSecondary">#E6FFFFFF</Color>
      <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF"/>
      <Color x:Key="AccentFillColorDisabled">#28FFFFFF</Color>
      <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#28FFFFFF"/>
      <Color x:Key="TextOnAccentFillColorDisabled">#87FFFFFF</Color>
      <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#87FFFFFF"/>
      <Color x:Key="AccentTextFillColorPrimary">#99E7FF</Color>
      <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#99E7FF"/>
      <Color x:Key="AccentTextFillColorSecondary">#99E7FF</Color>
      <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#99E7FF"/>
      <Color x:Key="AccentTextFillColorTertiary">#61CAFF</Color>
      <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#61CAFF"/>

      <!-- 3.1.2 Text -->
      <Color x:Key="TextFillColorPrimary">#FFFFFF</Color>
      <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF"/>
      <Color x:Key="TextFillColorSecondary">#C5FFFFFF</Color>
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF"/>
      <Color x:Key="TextFillColorTertiary">#87FFFFFF</Color>
      <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF"/>
      <Color x:Key="TextFillColorDisabled">#5DFFFFFF</Color>
      <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF"/>

      <!-- 3.1.3 Backgrounds / layers -->
      <Color x:Key="SolidBackgroundFillColorBase">#202020</Color>
      <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#202020"/>
      <Color x:Key="SolidBackgroundFillColorSecondary">#1C1C1C</Color>
      <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#1C1C1C"/>
      <Color x:Key="SolidBackgroundFillColorTertiary">#282828</Color>
      <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#282828"/>
      <Color x:Key="SolidBackgroundFillColorQuarternary">#2C2C2C</Color>
      <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#2C2C2C"/>
      <Color x:Key="LayerFillColorDefault">#4C3A3A3A</Color>
      <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#4C3A3A3A"/>
      <Color x:Key="LayerFillColorAlt">#0DFFFFFF</Color>
      <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#0DFFFFFF"/>
      <Color x:Key="CardBackgroundFillColorDefault">#0DFFFFFF</Color>
      <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF"/>
      <Color x:Key="CardBackgroundFillColorSecondary">#08FFFFFF</Color>
      <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#08FFFFFF"/>
      <Color x:Key="ControlFillColorDefault">#0FFFFFFF</Color>
      <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF"/>
      <Color x:Key="ControlFillColorSecondary">#15FFFFFF</Color>
      <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#15FFFFFF"/>
      <Color x:Key="ControlFillColorTertiary">#08FFFFFF</Color>
      <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#08FFFFFF"/>
      <Color x:Key="ControlFillColorDisabled">#0BFFFFFF</Color>
      <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0BFFFFFF"/>
      <Color x:Key="ControlFillColorInputActive">#B31E1E1E</Color>
      <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#B31E1E1E"/>
      <Color x:Key="SubtleFillColorTransparent">#00FFFFFF</Color>
      <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF"/>
      <Color x:Key="SubtleFillColorSecondary">#0FFFFFFF</Color>
      <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF"/>
      <Color x:Key="SubtleFillColorTertiary">#0AFFFFFF</Color>
      <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF"/>
      <Color x:Key="SmokeFillColorDefault">#4D000000</Color>
      <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000"/>

      <!-- 3.1.4 Strokes -->
      <Color x:Key="CardStrokeColorDefault">#19000000</Color>
      <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#19000000"/>
      <Color x:Key="CardStrokeColorDefaultSolid">#1C1C1C</Color>
      <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#1C1C1C"/>
      <Color x:Key="ControlStrokeColorDefault">#12FFFFFF</Color>
      <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF"/>
      <Color x:Key="ControlStrokeColorSecondary">#18FFFFFF</Color>
      <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#18FFFFFF"/>
      <Color x:Key="ControlStrongStrokeColorDefault">#8BFFFFFF</Color>
      <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8BFFFFFF"/>
      <Color x:Key="DividerStrokeColorDefault">#15FFFFFF</Color>
      <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF"/>
      <Color x:Key="SurfaceStrokeColorDefault">#66757575</Color>
      <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#66757575"/>
      <Color x:Key="FocusStrokeColorOuter">#FFFFFF</Color>
      <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FFFFFF"/>
      <Color x:Key="FocusStrokeColorInner">#B3000000</Color>
      <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#B3000000"/>

      <!-- 3.1.5 Semantic (system) colors - icons, dots and pill text only -->
      <Color x:Key="SystemFillColorSuccess">#6CCB5F</Color>
      <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#6CCB5F"/>
      <Color x:Key="SystemFillColorCaution">#FCE100</Color>
      <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FCE100"/>
